{
  "name": "crea-fitness-platform",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "install:all": "npm install",
    "dev": "node scripts/dev.mjs",
    "build": "npm run db:generate && npm run build --workspace @crea/web && npm run build --workspace @crea/api",
    "db:generate": "npm run db:generate --workspace @crea/api",
    "db:migrate": "npm run db:migrate --workspace @crea/api",
    "db:seed": "npm run db:seed --workspace @crea/api",
    "db:studio": "npm run db:studio --workspace @crea/api"
  }
}
